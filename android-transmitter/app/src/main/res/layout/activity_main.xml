<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_pitch"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <!-- Top Status Pill / Supercar Livery Tag -->
        <LinearLayout
            android:id="@+id/layout_top_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_badge_gold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_neon_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="FPV TELEMETRY RIG // MK-IV"
                android:textColor="@color/gold_bright"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_sys_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUALCOMM AVC"
            android:textColor="@color/neon_green"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            app:layout_constraintTop_toTopOf="@id/layout_top_tag"
            app:layout_constraintBottom_toBottomOf="@id/layout_top_tag"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Header Title -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="DRONE VIDEO STREAMER"
            android:textColor="@color/white_pure"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            app:layout_constraintTop_toBottomOf="@id/layout_top_tag"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="ULTRA-LOW LATENCY UDP • ESP32 BT MAVLINK"
            android:textColor="@color/neon_green"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="2dp" />

        <!-- Automotive Bright Gold Divider Accent -->
        <View
            android:id="@+id/divider_header"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/gold_bright"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Transmission Status Card (Automotive Gold Border) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/black_card"
            app:strokeColor="@color/gold_bright"
            app:strokeWidth="1.5dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/divider_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/view_status_indicator"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/dot_neon_idle" />

                    <TextView
                        android:id="@+id/tv_status_badge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="TRANSMITTER IDLE"
                        android:textColor="@color/gold_bright"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                    <!-- Livery Chip -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_gold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="HEADLESS"
                        android:textColor="@color/white_pure"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_status_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Direct Qualcomm hardware AVC pipe ready • Preview bypassed for ultra-low latency &amp; zero GPU load"
                    android:textColor="@color/white_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Network & Config Card (Automotive Gold Border) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_config"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/black_card"
            app:strokeColor="@color/gold_bright"
            app:strokeWidth="1.5dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/card_status"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Section Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="// TELEMETRY &amp; NETWORK PIPELINE"
                    android:textColor="@color/gold_bright"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="10dp" />

                <!-- Vercel Cloud Discovery & Registration -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_register_drone"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="REGISTER DRONE IP"
                        android:textColor="@color/neon_green"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:padding="0dp"
                        app:strokeColor="@color/neon_green"
                        app:strokeWidth="1dp"
                        app:cornerRadius="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_discover_target"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="SYNC FROM VERCEL"
                        android:textColor="@color/gold_bright"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:padding="0dp"
                        app:strokeColor="@color/gold_bright"
                        app:strokeWidth="1dp"
                        app:cornerRadius="6dp" />
                </LinearLayout>

                <!-- Target IP & Port -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TARGET LAPTOP IP"
                            android:textColor="@color/white_pure"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <EditText
                            android:id="@+id/et_target_ip"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_gold"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textColor="@color/white_pure"
                            android:textColorHint="@color/text_dim"
                            android:textSize="11sp"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:scrollHorizontally="true"
                            android:fontFamily="monospace"
                            android:inputType="text"
                            android:text="2401:4900:8f73:7949:8fa7:f1ad:81c1:b5b2" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PORT"
                            android:textColor="@color/white_pure"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <EditText
                            android:id="@+id/et_target_port"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_gold"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textColor="@color/neon_green"
                            android:textColorHint="@color/text_dim"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:inputType="number"
                            android:text="5005" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Resolution & FPS Selectors -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <!-- Quality / Resolution -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_resolution_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="QUALITY: AUTO (L &lt; 150ms)"
                            android:textColor="@color/gold_bright"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <RadioGroup
                            android:id="@+id/rg_resolution"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <RadioButton
                                android:id="@+id/rb_auto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="AUTO"
                                android:textColor="@color/white_pure"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                app:buttonTint="@color/radio_gold_tint" />

                            <RadioButton
                                android:id="@+id/rb_480p"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="480p"
                                android:textColor="@color/white_secondary"
                                android:textSize="11sp"
                                android:fontFamily="monospace"
                                app:buttonTint="@color/radio_gold_tint" />

                            <RadioButton
                                android:id="@+id/rb_360p"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="360p"
                                android:textColor="@color/white_secondary"
                                android:textSize="11sp"
                                android:fontFamily="monospace"
                                app:buttonTint="@color/radio_gold_tint" />
                        </RadioGroup>
                    </LinearLayout>

                    <!-- Target FPS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_fps_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TARGET FPS: 60 (16ms)"
                            android:textColor="@color/gold_bright"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <RadioGroup
                            android:id="@+id/rg_fps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <RadioButton
                                android:id="@+id/rb_fps_60"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="60 FPS"
                                android:textColor="@color/white_pure"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                app:buttonTint="@color/radio_gold_tint" />

                            <RadioButton
                                android:id="@+id/rb_fps_30"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30 FPS"
                                android:textColor="@color/white_secondary"
                                android:textSize="11sp"
                                android:fontFamily="monospace"
                                app:buttonTint="@color/radio_gold_tint" />
                        </RadioGroup>
                    </LinearLayout>
                </LinearLayout>

                <!-- Camera Image & Contrast Adjustment -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gold_subtle"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <CheckBox
                    android:id="@+id/cb_auto_contrast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTO CONTRAST &amp; EXPOSURE (ISP TONE-MAP)"
                    android:textColor="@color/gold_bright"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:checked="true"
                    app:buttonTint="@color/checkbox_neon_tint" />

                <TextView
                    android:id="@+id/tv_contrast_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="-2dp"
                    android:layout_marginBottom="4dp"
                    android:text="Dynamic range compression • Prevents blown highlights &amp; dark clipping"
                    android:textColor="@color/white_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />

                <!-- MAVLink Gold Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gold_subtle"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <!-- MAVLink Bridge Toggle -->
                <CheckBox
                    android:id="@+id/cb_enable_telem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BRIDGE MAVLINK TELEMETRY (ESP32 BT)"
                    android:textColor="@color/neon_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:checked="true"
                    app:buttonTint="@color/checkbox_neon_tint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ESP32 BT DEVICE NAME"
                            android:textColor="@color/white_pure"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <EditText
                            android:id="@+id/et_esp_ip"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_gold"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textColor="@color/white_pure"
                            android:textColorHint="@color/text_dim"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:inputType="text"
                            android:text="APM-Bridge" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TELEM PORT"
                            android:textColor="@color/white_pure"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <EditText
                            android:id="@+id/et_telem_port"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input_gold"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textColor="@color/neon_green"
                            android:textColorHint="@color/text_dim"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:inputType="number"
                            android:text="14551" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Real-Time Telemetry Matrix Card (Supercar Cockpit Instrument Grid) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/black_card"
            app:strokeColor="@color/gold_bright"
            app:strokeWidth="1.5dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/card_config"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Section Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="// REAL-TIME COCKPIT TELEMETRY"
                    android:textColor="@color/gold_bright"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="10dp" />

                <!-- Video Instruments Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Bitrate Cell -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_telemetry_cell"
                        android:padding="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BITRATE"
                            android:textColor="@color/gold_bright"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tv_bitrate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0 kbps"
                            android:textColor="@color/white_pure"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- FPS Cell -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_telemetry_cell"
                        android:padding="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FPS (TX)"
                            android:textColor="@color/gold_bright"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tv_fps_live"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0.0 fps"
                            android:textColor="@color/neon_green"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- Packets Cell -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_telemetry_cell"
                        android:padding="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PACKETS"
                            android:textColor="@color/gold_bright"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tv_packets"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0 pkts"
                            android:textColor="@color/white_pure"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Telemetry Instruments Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <!-- Uplink Cell -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_telemetry_cell"
                        android:padding="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TELEM UP"
                            android:textColor="@color/gold_bright"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tv_telem_uplink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0 pkts"
                            android:textColor="@color/white_pure"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- Downlink Cell -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_telemetry_cell"
                        android:padding="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TELEM DOWN"
                            android:textColor="@color/gold_bright"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tv_telem_downlink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0 pkts"
                            android:textColor="@color/white_pure"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- Link Status Cell -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_telemetry_cell"
                        android:padding="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TELEM LINK"
                            android:textColor="@color/gold_bright"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tv_telem_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="OFF"
                            android:textColor="@color/text_dim"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Start / Stop Button (Supercar Launch Ignition Control Style) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_stream"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:text="ENGAGE // START STREAMING"
            android:textColor="@color/white_pure"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            app:backgroundTint="@color/black_carbon"
            app:strokeColor="@color/gold_bright"
            app:strokeWidth="2dp"
            app:cornerRadius="14dp"
            app:elevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/card_stats"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>