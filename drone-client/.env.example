# ============================================================
# Drone Client Environment Configuration
# Place this at /etc/drone-registry.env or alongside drone_daemon.py
# ============================================================

# The URL of your deployed Vercel registration API
REGISTRY_URL="https://your-drone-registry.vercel.app"

# Unique identifier for this drone (alphanumeric, dash, underscore)
DEVICE_ID="DRONE-001"

# High-entropy token generated for this specific drone
DEVICE_TOKEN="replace_with_secure_random_token_from_gen_device"

# Drone listening UDP/TCP port (14550 for MAVLink telemetry, 5005 for H.264 video, etc.)
PORT=14550

# How often (seconds) to check if cellular IP has changed and pulse heartbeat
POLL_INTERVAL=15

# Optional: Specific network interface name to bind/monitor (e.g. wwan0, usb0, rmnet_data0)
# Leave blank to automatically select the cellular/global IPv6 interface
INTERFACE=

# Optional: Registration secret (only needed if your Vercel server requires REGISTRATION_SECRET for new devices)
REGISTRATION_SECRET=
