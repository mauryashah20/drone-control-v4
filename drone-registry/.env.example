# Required — Vercel Postgres connection string
# Set automatically when you add a Vercel Postgres database to your project.
# Format: postgres://user:pass@host/dbname?sslmode=require
POSTGRES_URL=

# Required — used to HMAC-hash device tokens before storing in the DB.
# Generate with: openssl rand -hex 32
# Must be kept secret. Changing this invalidates all existing device tokens.
TOKEN_SECRET=

# Required — secret that must be supplied when registering a BRAND NEW device.
# The drone sends this once on first registration.
# Generate with: openssl rand -hex 16
REGISTRATION_SECRET=

# Optional — allows admin to delete any device registration.
# Generate with: openssl rand -hex 16
ADMIN_SECRET=

# Optional — seconds after last heartbeat before a device is marked offline.
# Default: 60
ONLINE_THRESHOLD_SECONDS=60
