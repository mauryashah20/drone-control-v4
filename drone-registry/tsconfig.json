{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "outDir": ".vercel/output",
    "rootDir": ".",
    "baseUrl": "."
  },
  "include": ["api/**/*", "lib/**/*"],
  "exclude": ["node_modules", "drone-client", "ground-client", "scripts"]
}
